# 复制为 config.env 并填入你的真实值。
# config.env 已被 .gitignore 忽略，不会提交到仓库。
#   cp config.env.example config.env  &&  vi config.env

# 收件人邮箱（必填，改成你自己的）
RECIPIENT=you@example.com

# 榜单数量
TOP_N=10

# 是否用 Claude CLI 生成中文简介（1 开 / 0 关）
TRANSLATE=1
# Claude CLI 命令名或绝对路径
CLAUDE_BIN=claude

# 发送时间（被 install_launchagent.sh 用于生成 LaunchAgent）
# SEND_WEEKDAY: 1=周一 … 6=周六，0/7=周日
SEND_WEEKDAY=1
SEND_HOUR=9
SEND_MINUTE=0
